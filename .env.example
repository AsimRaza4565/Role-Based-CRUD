# MongoDB connection string.
# Recommended: use the SRV connection string (mongodb+srv://).
# If you encounter DNS/SRV lookup errors (e.g. "querySrv ECONNREFUSED"),
# use the standard (non-SRV) connection string from MongoDB Atlas instead.

MONGODB_URI=your-mongo-uri-here
NEXTAUTH_SECRET=your-secret
NEXTAUTH_URL=http://localhost:3000